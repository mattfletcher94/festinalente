{
  "name": "festinalente-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "check:dpdm": "npx dpdm -T --no-warning --exit-code circular:1 apps/vscode/src/extension.ts",
    "festinalente:build": "pnpm --filter @mattfletcher94/festinalente build",
    "festinalente:publish": "pnpm --filter @mattfletcher94/festinalente publish --no-git-checks",
    "vscode:watch": "pnpm --filter @mattfletcher94/festinalente-vscode watch",
    "vscode:package": "pnpm --filter @mattfletcher94/festinalente-vscode package",
    "vscode:local": "pnpm --filter @mattfletcher94/festinalente-vscode local",
    "vscode:publish": "pnpm --filter @mattfletcher94/festinalente-vscode publish --no-git-checks",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "oxlint": "^1.51.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  }
}
