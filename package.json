{
  "name": "claude-kanban-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "check:dpdm": "npx dpdm -T --no-warning --exit-code circular:1 apps/vscode/src/extension.ts",
    "kanban:build": "pnpm --filter claude-kanban build",
    "vscode:compile": "pnpm --filter claude-kanban-vscode compile",
    "vscode:watch": "pnpm --filter claude-kanban-vscode watch",
    "vscode:package": "pnpm --filter claude-kanban-vscode package"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  }
}
