{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema.plan.json",
  "title": "Plan Frontmatter",
  "description": "Schema for .kanban/plans/*.md YAML frontmatter",
  "type": "object",
  "required": ["task", "status", "created"],
  "properties": {
    "task": {
      "type": "string",
      "pattern": "^[0-9]{3}$",
      "description": "ID of the linked task"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "in-progress", "completed"],
      "default": "draft",
      "description": "Plan status"
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "Creation date"
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "Last update date"
    },
    "generated_by": {
      "type": "string",
      "description": "Who/what created the plan (human or claude)"
    },
    "model": {
      "type": "string",
      "description": "AI model used if generated"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Plan revision number"
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Current attempt/iteration number for tracking retries after verify/review failures"
    }
  }
}
