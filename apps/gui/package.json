    "reka-ui": "^2.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.0.0",
    "typescript": "^5.4.2",
    "vite": "^5.1.5",
