{
  "name": "@mattfletcher94/claudeban-vscode",
  "displayName": "Claude Kanban",
  "description": "AI-powered task management for Claude Code",
  "version": "0.1.1",
  "publisher": "claude-kanban",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mattfletcher94/claudeban"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kanban",
          "title": "Kanban",
          "icon": "resources/kanban-icon.svg"
        }
      ]
    },
    "views": {
      "kanban": [
        {
          "id": "kanbanTasks",
          "name": "Tasks"
        },
        {
          "id": "kanbanConfig",
          "name": "Config"
        },
        {
          "id": "kanbanGlobalActions",
          "name": "Global Actions"
        },
        {
          "id": "kanbanProductDocs",
          "name": "Product Docs"
        },
        {
          "id": "kanbanEngineeringDocs",
          "name": "Engineering Docs"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "kanbanTasks",
        "contents": "No .kanban folder found in this workspace.\n\nOpen a folder containing a .kanban directory to see tasks.",
        "when": "!kanban.hasKanbanFolder"
      },
      {
        "view": "kanbanConfig",
        "contents": "No config.yaml found.\n\nCreate .kanban/config.yaml to get started.",
        "when": "kanban.hasKanbanFolder && !kanban.hasConfigFile"
      }
    ],
    "commands": [
      {
        "command": "kanban.refresh",
        "title": "Kanban: Refresh Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "kanban.startDiscovery",
        "title": "Kanban: Start Discovery - Explore questions through Socratic Q&A",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "kanban.createTask",
        "title": "Kanban: Create Task - Capture problem, value, and acceptance criteria",
        "icon": "$(add)"
      },
      {
        "command": "kanban.findTask",
        "title": "Kanban: Find Task - Search by ID or title",
        "icon": "$(search)"
      },
      {
        "command": "kanban.runAction",
        "title": "Kanban: Run Action"
      },
      {
        "command": "kanban.runNextAction",
        "title": "Run Next Action",
        "icon": "$(play)"
      },
      {
        "command": "kanban.openTaskFolder",
        "title": "Open Task Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "kanban.openFile",
        "title": "Kanban: Open File"
      },
      {
        "command": "kanban.runGlobalAction",
        "title": "Kanban: Run Global Action"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kanban.startDiscovery",
          "when": "view == kanbanTasks && kanban.hasKanbanFolder",
          "group": "navigation@0"
        },
        {
          "command": "kanban.createTask",
          "when": "view == kanbanTasks && kanban.hasKanbanFolder",
          "group": "navigation@1"
        },
        {
          "command": "kanban.refresh",
          "when": "view == kanbanTasks",
          "group": "navigation@2"
        },
        {
          "command": "kanban.findTask",
          "when": "view == kanbanTasks && kanban.hasKanbanFolder",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "kanban.openTaskFolder",
          "when": "view == kanbanTasks && viewItem == task",
          "group": "inline@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "compile": "npm run build",
    "watch": "npm run build -- --watch",
    "lint": "eslint src --ext ts",
    "package": "npm run build && node scripts/package.cjs",
    "local": "node scripts/local-install.cjs",
    "prepublishOnly": "npm run package"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.12",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.27.3",
    "typescript": "^5.7.0"
  },
  "files": [
    "bin",
    "claudeban-vscode.vsix"
  ],
  "bin": {
    "claudeban-vscode": "bin/install.cjs"
  }
}