<plan task="{id}" spec="tasks/{id}/spec.xml" status="draft"
      complexity="{complexity}" created="{created}" updated="{updated}"
      generated-by="claude" model="{model}" version="1" iteration="1">
  <title>{title}</title>

  <overview></overview>

  <approach>
    <rationale></rationale>
    <breaking-changes></breaking-changes>
  </approach>

  <inventory></inventory>

  <tasks>
    <!-- Task template structure:
    <task id="1" type="auto" depends="optional-task-ids">
      <name>Short descriptive task name</name>
      <files>path/to/file.ts (create|modify), path/to/other.ts (modify)</files>
      <requirements>FR1, FR2</requirements>
      <pattern>Description of pattern to follow or file path reference</pattern>
      <context>
        <!-- Files the subagent should read BEFORE implementing this task.
             Include:
             - Existing files being modified (to understand current structure)
             - Pattern reference files (to see implementation examples)
             - Files containing imports/types/interfaces needed for the task
             - Related files that provide context for the change

             Note: Only include file paths here. Subagent will read these fresh.
             Do NOT include files being created (they don't exist yet). -->
        <file>path/to/existing/file.ts</file>
        <file>path/to/pattern/reference.ts</file>
      </context>
      <action>
        Detailed description of what to implement.
        Include specific changes, code structure, and any important details.
      </action>
      <verify>Command or check to verify the task is complete</verify>
      <done>Clear criteria that defines when this task is complete</done>
    </task>
    -->
  </tasks>

  <testing>
    <automated></automated>
    <manual></manual>
    <regression></regression>
  </testing>

  <edge-cases>
  </edge-cases>

  <pitfalls>
  </pitfalls>

  <iterations>
  </iterations>

  <wip>
  </wip>

  <completeness>
  </completeness>
</plan>
