{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "import"],
  "ignorePatterns": ["node_modules", "dist", ".turbo", "coverage", "scripts"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/sort-imports": "warn",
    "typescript/no-useless-constructor": "off",
    "typescript/no-extraneous-class": "off",
    "typescript/no-non-null-assertion": "off",
    "typescript/no-dynamic-delete": "off",
    "typescript/no-explicit-any": "off",
    "typescript/no-empty-object-type": "off",
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "eslint/no-empty-pattern": "off"
  }
}
